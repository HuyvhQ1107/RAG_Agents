# Google Gemini API (used for LLM, Embedding, and optional GeminiFlashReranker)
GEMINI_API_KEY=your_gemini_api_key_here

# Model roles (LiteLLM format)
LLM_FAST_MODEL=gemini/gemini-3.5-flash-lite
LLM_ANSWER_MODEL=gemini/gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIM=768

# Reranker provider: "gemini_flash" | "local_bge" | "heuristic"
RERANKER_PROVIDER=gemini_flash
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://rag_user:rag_pass@localhost:5432/rag_agents

# Security & Session
SESSION_SECRET=change_this_to_a_random_32_byte_hex_secret_in_production
SESSION_COOKIE_SECURE=false
# 32-byte url-safe base64 Fernet key for turns.question column encryption
FIELD_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Agent & RAG Hard Limits (FR-012, FR-014, Constitution V)
MAX_CLARIFICATIONS_PER_QUESTION=2
MAX_TURN_LLM_CALLS=8
MAX_RETRIEVAL_ROUNDS=2
MAX_TURN_INPUT_TOKENS=60000
MAX_TURN_COST_USD=0.05
RERANK_MIN_SCORE=0.25

# Document Upload & Blob Store
BLOB_STORE_BACKEND=local
BLOB_STORE_LOCAL_DIR=.data/blobs
MAX_UPLOAD_FILE_BYTES=52428800
MAX_UPLOAD_FILES_COUNT=20
